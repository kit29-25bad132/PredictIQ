# Predict IQ - FastAPI Backend Environment Configuration
# Copy this file to .env before starting the server

# Server Binding
PORT=8000
HOST=0.0.0.0

# Supabase PostgreSQL Session Pooler Configuration
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.vkqoauhrkbtskxsgnzvc
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# CORS Allowed Origins (Comma-separated list or * for local dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Environment Mode: development / production
ENVIRONMENT=development

# Optional ESP32 Authentication Token
ESP32_SECRET_TOKEN=SECURE_ESP32_TELEMETRY_TOKEN_2026
