# Predict IQ - Production Environment Variables
# Real-Data-First IoT Predictive Maintenance System

# PostgreSQL Connection String (using psycopg v3 driver or psycopg2)
# Format: postgresql+psycopg://username:password@localhost:5432/predictiq
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/predictiq

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ESP32 Device Offline Detection Threshold (in seconds)
DEVICE_TIMEOUT_SECONDS=60

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Browser API origin. Leave empty when the frontend is served behind the same origin.
VITE_API_URL=http://localhost:8000
