# PredictIQ V1 root environment template; copy to .env locally and replace placeholders.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# libpq sslmode: "require" for remote/managed DBs (backend default); "disable"
# only for local PostgreSQL without TLS (e.g. the docker-compose stack).
DB_SSLMODE=disable
DEVICE_API_KEY=LOCAL_DEVICE_KEY
CORS_ORIGINS=http://localhost:5173
# External AI (Gemini) analysis - POST /api/predictions/analyze.
# Required for that endpoint; without it the endpoint fails closed (HTTP 502)
# and never fabricates a prediction. Paste your real key ONLY in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Operator browser-write session authentication.
# OPERATOR_PASSWORD: password the browser SPA sends to POST /api/auth/login.
# OPERATOR_SESSION_SECRET: HMAC signing key for session cookies (generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Both MUST be set for browser operator writes to work.
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=
# Session duration in seconds (default 24 hours).
OPERATOR_SESSION_TTL_SECONDS=86400

# ============================================================================
# SUPABASE AUTH (user identity verification)
# ============================================================================
# Public project URL. The backend verifies Supabase access tokens against the
# project's PUBLIC JWKS; no service-role key, anon key or JWT secret is read.
# Leave empty to disable user authentication (dependent routes fail closed 503).
SUPABASE_URL=
# Optional overrides (derived from SUPABASE_URL when blank):
#   JWKS:   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#   Issuer: <SUPABASE_URL>/auth/v1
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Signing-key cache TTL (seconds) and clock-skew leeway for exp/nbf.
SUPABASE_JWKS_CACHE_SECONDS=3600
SUPABASE_JWT_LEEWAY_SECONDS=30
