# Predict IQ Frontend Environment Variables
# Copy to frontend/.env for local development.
#
# VITE_API_URL must stay UNSET in every environment. The bundle always calls
# same-origin /api/... paths and the host proxies them to the backend named by
# the runtime BACKEND_ORIGIN variable:
#   - dev:     tsx server.ts   -> createApiProxy()
#   - docker:  node dist/server.cjs -> createApiProxy()
#   - vercel:  api/index.ts    -> forwardApiRequest()
# Setting VITE_API_URL bypasses that proxy and calls the backend directly,
# which the backend's CORS policy then rejects.
# VITE_API_URL=

# Supabase Auth (public build-time values only - NEVER put the service-role
# key, database password or JWT signing secret in a VITE_ variable).
# Required for sign-in / sign-up / Google OAuth / password recovery (Phase 4).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
