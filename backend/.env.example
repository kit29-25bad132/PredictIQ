# PredictIQ V1 backend environment template; copy to .env locally and replace placeholders.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# libpq sslmode: "require" for remote/managed DBs (backend default); "disable"
# only for local PostgreSQL without TLS.
DB_SSLMODE=disable
DEVICE_API_KEY=LOCAL_DEVICE_KEY
CORS_ORIGINS=http://localhost:5173
# External AI (Gemini) analysis - POST /api/predictions/analyze.
# Required for that endpoint; without it the endpoint fails closed (HTTP 502)
# and never fabricates a prediction. Paste your real key ONLY in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Operator browser-write session authentication.
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=
OPERATOR_SESSION_TTL_SECONDS=86400
# Supabase Auth user-identity verification. Public project URL only; the
# backend fetches the project's PUBLIC JWKS. No service-role key or JWT secret
# is needed here. Empty disables user auth (dependent routes fail closed 503).
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600
SUPABASE_JWT_LEEWAY_SECONDS=30
