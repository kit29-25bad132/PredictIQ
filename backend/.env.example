# PredictIQ V1 backend environment template; copy to .env locally and replace placeholders.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# libpq sslmode: "require" for remote/managed DBs (backend default); "disable"
# only for local PostgreSQL without TLS.
DB_SSLMODE=disable
DEVICE_API_KEY=LOCAL_DEVICE_KEY
CORS_ORIGINS=http://localhost:5173
# External AI (Gemini) analysis - POST /api/predictions/analyze.
# Required for that endpoint; without it the endpoint fails closed (HTTP 502)
# and never fabricates a prediction. Paste your real key ONLY in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
