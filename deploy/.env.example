# PredictIQ Deployment Environment Template (production hardening)
#
# Copy this file to deploy/.env and replace EVERY placeholder value.
# NEVER commit deploy/.env or any real credentials; it is gitignored
# (.gitignore: .env, .env.*; only *.env.example templates are tracked).
#
# Usage:
#   cp deploy/.env.example deploy/.env
#   # Edit deploy/.env (see per-section guidance below)
#
#   Local demo (HTTP, no proxy):
#     docker compose --env-file deploy/.env -f deploy/docker-compose.yml up --build -d
#
#   Production (HTTPS via the nginx proxy profile):
#     docker compose --env-file deploy/.env -f deploy/docker-compose.yml --profile proxy up --build -d
#
# Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# The DATABASE_URL is used by the backend directly.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
#   - Compose stack:        host is the service name "database" (internal only)
#   - Managed/remote DB:    use the provider's connection string, host reachable
#                           from the VPS, with DB_SSLMODE=require
DATABASE_URL=postgresql+psycopg://predictiq:CHANGE_ME_PASSWORD@database:5432/predictiq

# libpq sslmode for the backend -> PostgreSQL connection.
#   disable : REQUIRED for the compose PostgreSQL (no TLS inside the compose
#             network; backend/app/core/config.py defaults to "require").
#   require : use for managed/remote production databases.
DB_SSLMODE=disable

# ==============================================================================
# DATABASE SERVICE (docker-compose.yml database service)
# ==============================================================================
# These configure the PostgreSQL container itself. The database is NEVER
# exposed to the host network; the backend reaches it over the internal
# Docker network as hostname "database".
DB_USER=predictiq
# REQUIRED: compose fails fast if this is unset (see docker-compose.yml).
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=predictiq

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Environment name. "production" enables the entrypoint safety checks:
#   - DEVICE_API_KEY must be set (non-placeholder, >= 24 chars)
#   - DATABASE_URL must be set (non-placeholder)
APP_ENV=production

# Host-bind addresses and ports for the frontend/backend. Defaults bind to
# 127.0.0.1 only: with the proxy profile these mappings are unused by real
# traffic (nginx reaches the services over the internal Docker network), and
# without the profile the stack stays private to the host (local demo via
# SSH tunnel or reverse proxy on the host).
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ==============================================================================
# FRONTEND API CONFIGURATION
# ==============================================================================
# The Vite bundle is built WITHOUT an API URL, so the browser calls
# same-origin "/api/..." and the Node frontend server proxies to
# BACKEND_ORIGIN=http://backend:8000 (set in docker-compose.yml). No action
# is needed here; VITE_API_URL is a build-time-only variable and must stay
# unset for production builds.

# ==============================================================================
# SECURITY - WRITE GATE AUTHENTICATION
# ==============================================================================
# Device API key for telemetry ingestion write-gate.
# Every mutating endpoint (POST /api/sensor-data, /api/predict, /api/feedback,
# /api/maintenance, /api/machines, /api/devices, /api/devices/heartbeat,
# /api/train-model, alert acknowledge/resolve) requires this key in the
# 'X-API-Key' header (Authorization: Bearer <key> also accepted).
#
# REQUIRED in production. With APP_ENV=production the backend entrypoint
# refuses to start when this is unset, still the placeholder, or shorter
# than 24 characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Then configure every ESP32/Wokwi device with the same key in its firmware
# config.h (DEVICE_API_KEY macro).
DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY

# ==============================================================================
# EXTERNAL AI - GEMINI PREDICTIVE ANALYSIS
# ==============================================================================
# Used only by POST /api/predictions/analyze. The key is read from the
# backend process environment (backend/app/core/config.py); it is never
# hardcoded, never logged, and never sent to the browser or firmware.
# Without GEMINI_API_KEY that endpoint fails closed (HTTP 502) and creates
# no prediction row; all other endpoints keep working.
# Generate/obtain a key from Google AI Studio; paste it ONLY in deploy/.env.
GEMINI_API_KEY=
# Model identifier sent to the Gemini REST API (gemini:<model> is persisted
# as the prediction's model_version). Override only when migrating models.
GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed browser origins for API access.
# Empty string disables browser CORS entirely.
#   Production (proxy serves frontend + /api on one origin): the public URL.
#   Local demo: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://predictiq.example.com

# ==============================================================================
# TLS / REVERSE PROXY (nginx, profile "proxy")
# ==============================================================================
# TLS termination happens in the "proxy" service inside the compose stack
# (deploy/TLS_SETUP.md Option A). Enabled only with:
#   docker compose ... --profile proxy up -d
# Full server procedure: deploy/README.md ("Server deployment procedure").

# Public hostname served by nginx (also your ACME/Certbot certificate name,
# substituted into deploy/nginx/predictiq.conf.template).
SERVER_NAME=predictiq.example.com

# Host ports published by the proxy service (the only public surface).
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# TLS certificates live OUTSIDE Git in deploy/nginx/certs/ (gitignored):
#   deploy/nginx/certs/fullchain.pem
#   deploy/nginx/certs/privkey.pem
# Obtain with Let's Encrypt (webroot mode, one-time standalone bootstrap:
#   sudo certbot certonly --standalone -d "$SERVER_NAME"
#   sudo cp /etc/letsencrypt/live/"$SERVER_NAME"/fullchain.pem deploy/nginx/certs/
#   sudo cp /etc/letsencrypt/live/"$SERVER_NAME"/privkey.pem  deploy/nginx/certs/
#   sudo chown "$USER" deploy/nginx/certs/*.pem
# ) or your cloud provider's certificate service. Never commit private keys.

# ==============================================================================
# LOCAL DEMO DEFAULTS (uncomment for the no-TLS local demo only)
# ==============================================================================
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SERVER_NAME=_
