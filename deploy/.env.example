# PredictIQ Deployment Environment Template (Phase 8)
#
# Copy this file to .env and replace the placeholder values.
# NEVER commit the .env file or any real credentials.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose -f deploy/docker-compose.yml up --build -d

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# The DATABASE_URL is used by the backend directly.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
# For local Docker deployment, use the service name "database" as host.
DATABASE_URL=postgresql+psycopg://predictiq:CHANGE_ME_PASSWORD@database:5432/predictiq

# libpq sslmode for the backend -> PostgreSQL connection.
#   disable   : REQUIRED for the local docker-compose PostgreSQL (no TLS).
#   require   : use for managed/remote production databases (backend default).
# The local compose stack sets DB_SSLMODE=disable; production environments
# must explicitly provide their own value (default require in config.py).
DB_SSLMODE=disable

# Alternative: individual database settings (used if DATABASE_URL is empty)
# DB_HOST=database
# DB_PORT=5432
# DB_NAME=predictiq
# DB_USER=predictiq
# DB_PASSWORD=CHANGE_ME_PASSWORD

# ==============================================================================
# DATABASE SERVICE (docker-compose.yml database section)
# ==============================================================================
# These are used to configure the PostgreSQL container itself.
DB_USER=predictiq
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=predictiq
DB_PORT=5432

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Environment name (development, staging, production)
APP_ENV=production

# Backend server port (must match docker-compose ports mapping)
BACKEND_PORT=8000

# Frontend server port (must match docker-compose ports mapping)
FRONTEND_PORT=3000

# ==============================================================================
# FRONTEND API CONFIGURATION
# ==============================================================================
# URL the frontend uses to reach the backend API.
# In production with a reverse proxy, this would be the public URL.
# For local Docker, use http://localhost:BACKEND_PORT or the service URL.
VITE_API_URL=http://localhost:8000

# ==============================================================================
# SECURITY - WRITE GATE AUTHENTICATION
# ==============================================================================
# Device API key for telemetry ingestion write-gate.
# Every mutating endpoint (POST /api/sensor-data, /api/predict, /api/feedback,
# /api/maintenance, /api/machines, /api/devices, /api/devices/heartbeat,
# /api/train-model, alert acknowledge/resolve) requires this key in the
# 'X-API-Key' header (Authorization: Bearer <key> also accepted).
# In production, set a strong random key and configure devices with it.
# Leave empty ONLY in development: an empty key disables the gate with a
# startup warning in the backend logs.
DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins for browser-based API access.
# Must include the frontend URL(s). Empty string disables browser CORS.
# Examples:
#   Local dev: http://localhost:3000,http://localhost:5173
#   Production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# TLS / REVERSE PROXY (Deployment Verification Pending)
# ==============================================================================
# TLS termination is NOT configured in this skeleton.
# For production deployment:
#
# Option A - Reverse Proxy (e.g., nginx, Traefik, Caddy):
#   1. Deploy a reverse proxy in front of the frontend service
#   2. Configure TLS certificates (see TLS_SETUP.md for details)
#   3. Proxy /api/* requests to the backend service
#   4. Set CORS_ORIGINS to your public domain
#   5. Set VITE_API_URL to the public URL
#
# Option B - Cloud Load Balancer / Ingress:
#   1. Provision TLS certificates via your cloud provider or Let's Encrypt
#   2. Configure the load balancer to terminate TLS
#   3. Forward traffic to the frontend and backend services
#
# NEVER commit private keys or certificate files to this repository.
# TLS_SETUP.md documents the requirements without containing secrets.

# ==============================================================================
# DEMO / DEVELOPMENT OVERRIDES
# ==============================================================================
# For demo purposes only - do not use in production.
# SKIP_WRITE_GATE=true  # Disable device API key check (development only)
