# PredictIQ Gateway Environment Configuration
#
# Copy to deploy/gateway/.env and fill in real values.
# NEVER commit .env files.

# Render backend base URL (HTTPS only, fail-closed)
RENDER_BACKEND_URL=https://predictiq-backend-771t.onrender.com

# DEVICE_API_KEY from the Render backend (server-side only, never exposed to Wokwi)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RENDER_DEVICE_API_KEY=

# Application-level token for Wokwi -> Gateway auth (never the Render key)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# Comma-separated allowed device IDs
ALLOWED_DEVICES=ESP32_001

# Comma-separated allowed machine IDs
ALLOWED_MACHINES=TEST-001

# Request size limit (bytes)
MAX_REQUEST_BYTES=8192

# Rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Upstream timeout (seconds)
UPSTREAM_TIMEOUT_SECONDS=10.0

# Server bind
HOST=0.0.0.0
PORT=9000
