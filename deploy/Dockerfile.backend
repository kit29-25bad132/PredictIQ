# PredictIQ Backend Deployment (Phase 8)
#
# Builds the FastAPI backend with all Python dependencies and runs migrations
# before starting the application. No secrets are baked into this image.
#
# Service: backend
# Port: 8000
# Volume: ./data/postgres (mounted by docker-compose, not here)
#
# Environment variables required (injected at runtime):
#   DATABASE_URL - PostgreSQL connection string
#   DEVICE_API_KEY - optional write-gate token for telemetry ingestion
#   CORS_ORIGINS - comma-separated allowed origins (empty = no browser CORS)
#   APP_ENV - deployment environment name (default: production)
#
# No credentials, passwords, API keys, or certificates are committed.
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for psycopg binary and build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better layer caching
COPY backend/requirements.txt ./requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY ml/ ./ml/

# Alembic migration assets MUST live at /app for `alembic upgrade head` to
# resolve script_location=alembic (relative to the working directory).
# alembic/env.py imports backend.app.db.*, which resolves because backend/ is
# copied as a package directory under /app (PYTHONPATH includes the workdir).
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic

# Allow compile-time verification of migrations inside the image
# (docker build ... --build-arg VERIFY_MIGRATIONS=true). Off by default so
# production builds do not require a live database.
ARG VERIFY_MIGRATIONS=false
RUN if [ "$VERIFY_MIGRATIONS" = "true" ]; then \
        python -c "import alembic, sqlalchemy, fastapi; print('migration toolchain OK')"; \
    fi

# Make the entrypoint executable
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose the FastAPI port
EXPOSE 8000

# Set environment defaults (no real secrets)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production

# Healthcheck: verify the health endpoint responds
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; \
    urllib.request.urlopen('http://localhost:8000/api/health', timeout=5)" || exit 1

# Prove at build time that the app path is importable from the container layout:
# this catches regressions like a missing package __init__ or wrong module path.
RUN python -c "import backend.app.main; print('backend.app.main:app importable from /app')"

# Run migrations then start the application
ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
